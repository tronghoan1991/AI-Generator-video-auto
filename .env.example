TTS_PROVIDER=omnivoice
# Local OmniVoice default; in Render use a reachable remote URL.
OMNIVOICE_ENDPOINT=http://127.0.0.1:8123
TTS_CONCURRENCY=1

TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_OWNER_CHAT_ID=123456789
HOST=0.0.0.0
PORT=8080
WAKE_TOKEN=replace-with-long-random-string
WORKER_POLL_INTERVAL_MS=15000
DATA_ROOT=./data
OUTPUT_ROOT=./output/telegram-jobs
