{
  "name": "ai-generator-video-auto",
  "version": "2.0.0",
  "description": "Telegram-first AI video generator with the original HyperFrames + OmniVoice pipeline",
  "main": "src/cli.ts",
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "pipeline": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "sfx:download": "tsx scripts/download-sfx.ts",
    "sfx:filter": "tsx scripts/filter-sfx.ts",
    "start": "tsx src/app.ts",
    "bot": "tsx src/app.ts"
  },
  "keywords": [
    "automation",
    "claude-code",
    "hyperframes",
    "news",
    "omnivoice",
    "queue",
    "shorts",
    "telegram",
    "tiktok",
    "tts",
    "video",
    "vietnamese"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.15.2",
    "dotenv": "^17.4.2",
    "p-limit": "^7.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "nock": "^14.0.13",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
